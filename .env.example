# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # serveur uniquement (ingestion des offres, jamais côté client)

# Fournisseurs IA : remplissez au moins une clé. Les autres servent de repli.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Routage des modèles par type de tâche, au format "fournisseur:modèle".
# Plusieurs modèles séparés par des virgules = ordre de repli.
# Exemples : anthropic:claude-sonnet-5-5 · openrouter:openai/gpt-4o-mini
AI_MODELS_FAST=openrouter:openai/gpt-4o-mini,anthropic:claude-haiku-4-5-20251001
AI_MODELS_SMART=anthropic:claude-sonnet-5-5,openrouter:openai/gpt-4o-mini
AI_MODELS_RESEARCH=anthropic:claude-sonnet-5-5,openrouter:openai/gpt-4o-mini

# Recherche d'offres (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ca

# Plafond de générations IA par utilisateur et par jour (contrôle des coûts)
AI_DAILY_LIMIT=60

NEXT_PUBLIC_SITE_URL=http://localhost:3000
